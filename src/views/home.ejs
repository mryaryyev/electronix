<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/home.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/vanta@latest/dist/vanta.net.min.js"></script>

<body>
  <% if(!member) { %>

  <div class="home-container" id="vanta-bg">
    <div class="main">
      <span class="admin-panel">Admin panel</span>
      <h1 class="project-name">Electronix</h1>
      <p class="admin-text">
        Manage products, orders and customer accounts for your ELECTRONIX
        STORE
      </p>
      <div class="signup-login">
        <div class="admin-signup-login">
          <span class="info">Don't have an account?</span>
          <a class="signup-link" href="/admin/signup">Sign up</a>
        </div>
        <div class="admin-signup-login">
          <span class="info">Already have an account?</span>
          <a class="login-link" href="/admin/login">Log in</a>
        </div>
      </div>
    </div>
  </div>

  <% } else { %>

  <div class="admin-layout">
    <%- include('includes/sidebar', { active: 'overview' }) %>

    <main class="admin-main">
      <%- include('includes/topbar') %>

      <div class="content">
        <div class="admin-topbar">
          <h1>Overview</h1>
        </div>

        <div class="stat-grid">
          <div class="stat-card">
            <div class="label">Products</div>
            <div class="value"><%= products.length %></div>
          </div>
          <div class="stat-card">
            <div class="label">Customers</div>
            <div class="value"><%= users.length %></div>
          </div>
          <div class="stat-card">
            <div class="label">Orders today</div>
            <div class="value"><%= todayOrders.length %></div>
          </div>
          <div class="stat-card">
            <div class="label">Revenue today</div>
            <div class="value">$<%= revenueToday %></div>
          </div>
        </div>

        <div class="row">
          <div class="panel">
            <div class="panel-head"><h2>Orders this week</h2></div>
            <div class="chart">
              <% weeklyChart.forEach(function(day) { %>
              <div class="bar-col">
                <div class="bar" style="height: <%= day.pct %>%"></div>
                <span class="bar-label"><%= day.label %></span>
              </div>
              <% }) %>
            </div>
          </div>

          <div class="panel">
            <div class="panel-head">
              <h2>Low stock alert</h2>
              <a href="/admin/product/all">View all</a>
            </div>
            <ul class="panel-list">
              <% if(lowStockProducts.length === 0) { %>
              <li><span class="item-name">Nothing low on stock right now.</span></li>
              <% } %>
              <% lowStockProducts.forEach(function(p) { %>
              <li>
                <span class="item-name"><%= p.productName %></span>
                <span class="pill low"><%= p.productLeftCount %> left</span>
              </li>
              <% }) %>
            </ul>
          </div>
        </div>

        <div class="row">
          <div class="panel">
            <div class="panel-head">
              <h2>Recent orders</h2>
              <a href="/admin/order/all">View all</a>
            </div>
            <ul class="panel-list">
              <% if(recentOrders.length === 0) { %>
              <li><span class="item-name">No orders yet.</span></li>
              <% } %>
              <% recentOrders.forEach(function(o) { %>
              <li>
                <span class="item-name">#<%= String(o._id).slice(-6) %> &middot; <%= o.memberNick %></span>
                <span class="pill <%= o.orderStatus.toLowerCase() %>"><%= o.orderStatus %></span>
              </li>
              <% }) %>
            </ul>
          </div>

          <div class="panel">
            <div class="panel-head">
              <h2>Top customers</h2>
              <a href="/admin/user/all">View all</a>
            </div>
            <ul class="panel-list">
              <% if(topCustomers.length === 0) { %>
              <li><span class="item-name">No customer activity yet.</span></li>
              <% } %>
              <% topCustomers.forEach(function(c, i) { %>
              <li>
                <div class="cust-row">
                  <span class="rank"><%= i + 1 %></span>
                  <span class="item-name"><%= c.memberNick %></span>
                </div>
                <span class="item-meta"><%= c.memberPoints %> pts</span>
              </li>
              <% }) %>
            </ul>
          </div>
        </div>
      </div>
    </main>
  </div>

  <% } %>

  <script type="text/javascript" src="/js/home.js"></script>
</body>

<%- include('includes/footer') %>
