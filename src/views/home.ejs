<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/home.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/vanta@latest/dist/vanta.net.min.js"></script>

<body>
  <% if(!member) { %>

  <div class="home-container" id="vanta-bg">
    <!-- <div class="navigation-menu">
      <ul class="nav justify-content-center">
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link active" href="/admin">Home</a>
        </li>
      </ul>
    </div> -->

    <div class="hero-content">
      <span class="eyebrow">Admin Panel</span>
      <h1 class="brand-title">Electronix</h1>
      <p class="tagline">
        Manage products, orders and customer accounts for your ELECTRONIX
        STORE
      </p>
      <div class="cta-row">
        <div class="cta-col">
          <span class="cta-caption">Don't have an account?</span>
          <a class="btn-primary" href="/admin/signup">Sign up</a>
        </div>
        <div class="cta-col">
          <span class="cta-caption">Already have an account?</span>
          <a class="link-quiet" href="/admin/login">Log in</a>
        </div>
      </div>
    </div>
  </div>

  <% } else { %>

  <div class="admin-layout">
    <%- include('includes/sidebar', { active: 'overview' }) %>

    <main class="admin-main">
      <div class="topbar">
        <div class="search-box">Search products, orders, customers...</div>
        <div class="topbar-right">
          <div class="icon-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
          </div>
          <div class="profile">
            <div class="avatar"><%= member.memberNick.slice(0, 2).toUpperCase() %></div>
            <div>
              <div class="name"><%= member.memberNick %></div>
              <div class="role">Store admin</div>
            </div>
          </div>
        </div>
      </div>

      <div class="content">
        <div class="admin-topbar">
          <h1>Overview</h1>
          <div class="welcome">Here's what's happening in your store today.</div>
        </div>

        <div class="stat-grid">
          <div class="stat-card">
            <div class="label">Products</div>
            <div class="value"><%= productCount %></div>
          </div>
          <div class="stat-card">
            <div class="label">Customers</div>
            <div class="value"><%= memberCount %></div>
          </div>
          <div class="stat-card">
            <div class="label">Orders today</div>
            <div class="value"><%= orderCount %></div>
          </div>
          <div class="stat-card">
            <div class="label">Revenue today</div>
            <div class="value">$<%= revenueToday %></div>
          </div>
        </div>

        <div class="row">
          <div class="panel">
            <div class="panel-head"><h2>Orders this week</h2></div>
            <div class="chart">
              <% weeklyChart.forEach(function(day) { %>
              <div class="bar-col">
                <div class="bar" style="height: <%= day.pct %>%"></div>
                <span class="bar-label"><%= day.label %></span>
              </div>
              <% }) %>
            </div>
          </div>

          <div class="panel">
            <div class="panel-head">
              <h2>Low stock alert</h2>
              <a href="/admin/product/all">View all</a>
            </div>
            <ul class="panel-list">
              <% if(lowStockProducts.length === 0) { %>
              <li><span class="item-name">Nothing low on stock right now.</span></li>
              <% } %>
              <% lowStockProducts.forEach(function(p) { %>
              <li>
                <span class="item-name"><%= p.productName %></span>
                <span class="pill low"><%= p.productLeftCount %> left</span>
              </li>
              <% }) %>
            </ul>
          </div>
        </div>

        <div class="row">
          <div class="panel">
            <div class="panel-head">
              <h2>Recent orders</h2>
              <a href="/admin/order/all">View all</a>
            </div>
            <ul class="panel-list">
              <% if(recentOrders.length === 0) { %>
              <li><span class="item-name">No orders yet.</span></li>
              <% } %>
              <% recentOrders.forEach(function(o) { %>
              <li>
                <span class="item-name">#<%= String(o._id).slice(-6) %> &middot; <%= o.memberNick %></span>
                <span class="pill <%= o.orderStatus.toLowerCase() %>"><%= o.orderStatus %></span>
              </li>
              <% }) %>
            </ul>
          </div>

          <div class="panel">
            <div class="panel-head">
              <h2>Top customers</h2>
              <a href="/admin/user/all">View all</a>
            </div>
            <ul class="panel-list">
              <% if(topCustomers.length === 0) { %>
              <li><span class="item-name">No customer activity yet.</span></li>
              <% } %>
              <% topCustomers.forEach(function(c, i) { %>
              <li>
                <div class="cust-row">
                  <span class="rank"><%= i + 1 %></span>
                  <span class="item-name"><%= c.memberNick %></span>
                </div>
                <span class="item-meta"><%= c.memberPoints %> pts</span>
              </li>
              <% }) %>
            </ul>
          </div>
        </div>
      </div>
    </main>
  </div>

  <% } %>

  <script type="text/javascript" src="/js/home.js"></script>
</body>

<%- include('includes/footer') %>
