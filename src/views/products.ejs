<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/products.css" />

<body>
  <div class="admin-layout">
    <%- include('includes/sidebar', { active: 'products' }) %>

    <main class="admin-main">
      <%- include('includes/topbar') %>

      <div class="content">
        <div class="admin-topbar">
          <h1>Products</h1>
        </div>

        <div class="panel">
          <div class="panel-head">
            <h2>Product list</h2>
            <button class="btn btn-primary" id="process-btn">New Product</button>
          </div>

          <table class="table table-bordered table-hover data">
            <thead class="thead-light">
              <tr class="thead-light">
                <th scope="col">No</th>
                <th scope="col">Product Name</th>
                <th scope="col">Product Category</th>
                <th scope="col">Product Brand</th>
                <th scope="col">Product Price</th>
                <th scope="col">Product Left Count</th>
                <th scope="col">Status</th>
              </tr>
            </thead>
              <% products.map(function(value, key) { %>
                <tbody style="background: white">
              <td><%= key + 1%></td>
              <td><%= value.productName %></td>
              <td><%= value.productCategory %></td>
              <td><%= value.productBrand %></td>
              <td><%= value.productPrice %></td>
              <td><%= value.productLeftCount %></td>
              <td>
                <select class="spec-select new-product-status status-<%= value.productStatus.toLowerCase() %>" id="<%= value._id %>">
                  <option value="PAUSE" <%= value.productStatus === 'PAUSE' ? 'selected': ''%> >PAUSE</option>
                  <option value="PROCESS" <%= value.productStatus === 'PROCESS' ? 'selected': ''%> >PROCESS</option>
                  <option value="DELETE" <%= value.productStatus === 'DELETE' ? 'selected': ''%> >DELETE</option>
                </select>
              </td>
            </tbody>
              <% }) %>
          </table>
        </div>

        <form
          onsubmit="return validateForm()"
          action="/admin/product/create"
          method="POST"
          class="dish-container panel"
          enctype="multipart/form-data"
        >
          <div class="panel-head">
            <h2>New product detail</h2>
          </div>

          <div class="form-body">
            <div class="long-input">
              <label>Product Name</label>
              <input
                type="text"
                placeholder="Name"
                name="productName"
                class="product-name"
              />
            </div>
            <input
              name="productStatus"
              value="PROCESS"
              class="product-status"
              hidden
            />

            <div class="half-input-frame">
              <div class="half-input">
                <label>Product Price</label>
                <input
                  type="number"
                  placeholder="Price"
                  name="productPrice"
                  class="product-price"
                />
              </div>
              <div class="half-input">
                <label>Product Left Counts</label>
                <input
                  type="number"
                  placeholder="Counts"
                  name="productLeftCount"
                  class="product-left-count"
                />
              </div>
            </div>

            <div class="half-input-frame">
              <div class="half-input">
                <label>Product Category</label>
                <select class="product-category" name="productCategory">
                  <option value="SMARTPHONE" selected>Smartphone</option>
                  <option value="LAPTOP">Laptop</option>
                  <option value="TABLET">Tablet</option>
                  <option value="SMARTWATCH">Smartwatch</option>
                  <option value="CAMERA">Camera</option>
                  <option value="ACCESSORY">Accessory</option>
                </select>
              </div>

              <div class="half-input">
                <label>Product Brand</label>
                <select class="product-brand" name="productBrand">
                  <option value="APPLE" selected>Apple</option>
                  <option value="SAMSUNG">Samsung</option>
                  <option value="LENOVO">Lenovo</option>
                  <option value="ASUS">Asus</option>
                  <option value="XIAOMI">Xiaomi</option>
                  <option value="HUAWEI">Huawei</option>
                </select>
              </div>
            </div>

            <div class="long-input">
              <label>Product Description</label>
              <textarea name="productDesc" class="product-desc"></textarea>
            </div>
            <div class="long-input">
            <label>Product Specs (Key Features)</label>
            <div id="specs-container">
             <div class="spec-row">
              <input type="text" class="spec-key" placeholder="e.g. Display" />
              <input type="text" class="spec-value" placeholder="e.g. 13.6 inches Retina" />
            <button type="button" class="btn btn-danger remove-spec-btn">✕</button>
              </div>
            </div>
            <button type="button" class="btn btn-secondary" id="add-spec-btn">+ Add Spec</button>
</div>

<input type="hidden" name="productSpecs" id="product-specs-hidden" />

            <div class="img-frame">
              <label>Product Images</label>
              <div class="media-frame">
                <div class="upload-img-box">
                  <img src="/img/upload.svg" class="1" id="image-section-1" />
                  <input
                    type="file"
                    id="file"
                    name="productImages"
                    class="image-one"
                    required
                    onchange="previewFileHandler(this, 1)"
                  />
                </div>
                <div class="upload-img-box">
                  <img src="/img/upload.svg" class="2" id="image-section-2" />
                  <input
                    type="file"
                    id="file"
                    name="productImages"
                    class="image-two"
                    onchange="previewFileHandler(this, 2)"
                  />
                </div>
                <div class="upload-img-box">
                  <img src="/img/upload.svg" class="3" id="image-section-3" />
                  <input
                    type="file"
                    id="file"
                    name="productImages"
                    class="image-three"
                    onchange="previewFileHandler(this, 3)"
                  />
                </div>
                <div class="upload-img-box">
                  <img src="/img/upload.svg" class="4" id="image-section-4" />
                  <input
                    type="file"
                    id="file"
                    name="productImages"
                    class="image-four"
                    onchange="previewFileHandler(this, 4)"
                  />
                </div>
                <div class="upload-img-box">
                  <img src="/img/upload.svg" class="5" id="image-section-5" />
                  <input
                    type="file"
                    id="file"
                    name="productImages"
                    class="image-five"
                    onchange="previewFileHandler(this, 5)"
                  />
                </div>
              </div>
            </div>

            <div class="operation-buttons">
              <button class="btn btn-danger" id="cancel-btn" type="button">Cancel</button>
              <button type="submit" class="btn btn-primary" id="create-btn">
                Create
              </button>
            </div>
          </div>
        </form>
      </div>
    </main>
  </div>

  <script type="text/javascript" src="/js/products.js"></script>
</body>

<%- include('includes/footer') %>